{
  "name": "@jetstreamapp/sf-formula-parser",
  "version": "2.2.0",
  "description": "Salesforce formula parser and evaluator — parse and execute Salesforce formula expressions in JavaScript",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "prebuild": "npm run clean",
    "build": "npm run build:esm && npm run build:lwc && npm run build:cjs && npm run build:declarations",
    "build:esm": "esbuild src/index.ts --bundle --outfile=dist/esm/index.mjs --minify --format=esm --target=es2022 --banner:js='/*! @jetstreamapp/sf-formula-parser | MIT License | https://github.com/jetstreamapp/sf-formula-parser */'",
    "build:lwc": "esbuild src/index.ts --bundle --outfile=dist/lwc/index.js --format=esm --target=es2022 --banner:js='/*! @jetstreamapp/sf-formula-parser | MIT License | https://github.com/jetstreamapp/sf-formula-parser */'",
    "build:cjs": "esbuild src/index.ts --bundle --outfile=dist/cjs/index.js --minify --format=cjs --target=es2022 --banner:js='/*! @jetstreamapp/sf-formula-parser | MIT License | https://github.com/jetstreamapp/sf-formula-parser */'",
    "build:declarations": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify:formulas": "tsx scripts/formula-verify/verify.ts",
    "release": "node scripts/release.mjs",
    "release:ci": "release-it",
    "release:increment": "node scripts/derive-increment.mjs --explain"
  },
  "author": "Austin Turner <austin@getjetstream.app>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "release-it": "^21.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "salesforce",
    "formula",
    "parser",
    "evaluator",
    "sf",
    "apex",
    "soql",
    "lwc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetstreamapp/sf-formula-parser.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
